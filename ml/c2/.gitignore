# Local datasets (prevent accidental git commits of large image archives)
/data/*
!/data/.gitkeep
!/data/__init__.py
!/data/irt_dataset.py
!/data/segmentation_dataset.py
!/data/samples/
!/data/samples/*

# Model weights & checkpoints
/weights/*
!/weights/.gitkeep

# Experiment logs and curves
/runs/*
/experiments/*
!/runs/.gitkeep

# Caches
*.cache
.cache/
wandb/

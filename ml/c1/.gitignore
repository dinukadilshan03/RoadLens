# Local datasets (preserve directory scaffold via .gitkeep)
/data/*
!/data/.gitkeep

# Model weights & checkpoints
/weights/*
!/weights/.gitkeep

# Training run artifacts, curves, and validation plots
/runs/*
!/runs/.gitkeep

# Local survey fixtures and test image sequences
/fixtures/*
!/fixtures/.gitkeep
!/fixtures/samples/
!/fixtures/samples/*

# ML caches and experiment tracking
*.cache
.cache/
wandb/
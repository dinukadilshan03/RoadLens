# Git & local environment
.git
.venv
venv
env
.env
.env.*
!.env.example
.tmp-uv-cache
.uv-cache
.pip-cache
.agents
graphify-out

# Python caches & test artifacts
**/__pycache__
**/*.py[cod]
**/*$py.class
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Frontend (Backend build context does not need frontend source code)
frontend
**/node_modules
**/.next

# ML datasets, runs, weights, archives & Colab training artifacts (prevents multi-GB context leak)
ml/c1/data
ml/c1/data/**
ml/c1/scripts
ml/c1/configs
ml/c2/configs
ml/c2/data/*
!ml/c2/data/__init__.py
!ml/c2/data/irt_dataset.py
!ml/c2/data/samples
!ml/c2/data/samples/**
**/runs
**/runs/**
**/experiments
**/experiments/**
**/weights
**/weights/**
**/notebooks
**/notebooks/**
**/.ipynb_checkpoints
*.pt
*.pth
*.onnx
*.engine
*.safetensors
*.tflite
*.joblib
*.zip
*.tar
*.tar.gz
*.cache
wandb

# Keep lightweight runtime demo fixtures required by C1 and C4 demo endpoints
**/fixtures/*
!ml/c1/fixtures
!ml/c1/fixtures/samples
!ml/c1/fixtures/samples/**
!ml/c4/fixtures
!ml/c4/fixtures/synthetic_drive
!ml/c4/fixtures/synthetic_drive/**

# Documentation and tests (not needed inside application runtime container)
docs
tests
**/tests
*.md
!README.md

# OS & IDE metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.vscode
.idea
*.log

# The selected C3 runtime bundle is required for inference.
!ml/c3/selected_model.pt

# Git & local environment
.git
.venv
.env
.env.*
!.env.example
.tmp-uv-cache

# Python caches & test artifacts
__pycache__
*.py[cod]
*$py.class
.pytest_cache
.ruff_cache
.coverage
htmlcov

# Frontend (Backend build context does not need frontend source code)
frontend
**/node_modules
**/.next

# ML datasets, runs, weights, archives & notebook caches (prevents multi-GB context leak)
**/data
**/data/**
**/runs
**/runs/**
**/weights
**/weights/**
**/notebooks
**/notebooks/**
**/fixtures
**/fixtures/**
**/.ipynb_checkpoints
*.pt
*.pth
*.onnx
*.engine
*.safetensors
*.tflite
*.zip
*.tar
*.tar.gz
*.cache
wandb

# Documentation and tests (not needed inside application runtime container)
docs
**/tests
*.md
!README.md

# OS & IDE metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.vscode
.idea
*.log

# The selected C3 runtime bundle is required for inference.
!ml/c3/selected_model.pt
